# Copy to .env.local and adjust as needed. Both values below are the code defaults.

# Base URL of the Open Knesset FastAPI backend (src/lib/api/client.ts)
NEXT_PUBLIC_API_BASE_URL=https://backend.oknesset.org

# Current Knesset term number (src/lib/data/cache.ts)
NEXT_PUBLIC_CURRENT_KNESSET_NUM=25
